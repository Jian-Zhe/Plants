rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid;
    }

    function isValidPlant(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.family is string && data.family.size() <= 100;
    }

    // 2. User Profiles and Subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      // User's private wild plants collection
      match /plants/{plantId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(plantId) && isValidPlant(incoming());
        allow update: if isOwner(userId) && isValidId(plantId) && isValidPlant(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(plantId);
      }

      // User's private configuration & settings (e.g. Gemini API key & preferred model)
      match /settings/{settingId} {
        allow get, list, create, update, delete: if isOwner(userId) && isValidId(settingId);
      }
    }
  }
}
